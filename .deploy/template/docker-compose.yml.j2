name: planno_${ENV_NAME}

services:
  app:
    image: registry.srvgitlab.decalog.net/app/planno/planno:latest
    container_name: planno_app_${ENV_NAME}
    env_file:
      - .env
    volumes:
      - .:/var/www/html
    depends_on:
      db:
        condition: service_healthy
    ports:
      - "8081:80"
    networks:
      - decalog_planno

  db:
    image: mariadb:10.11
    container_name: planno_db_${ENV_NAME}
    environment:
      MARIADB_ROOT_PASSWORD: ${DB_ROOT_PASSWORD}
      MARIADB_DATABASE: ${DB_NAME}
      MARIADB_USER: ${DB_USER}
      MARIADB_PASSWORD: ${DB_PASSWORD}
    ports:
      - "3303:3306"
    volumes:
      - db_data:/var/lib/mysql
    healthcheck:
      test: ["CMD", "mysqladmin", "ping", "-h", "localhost", "-uroot", "-p${DB_ROOT_PASSWORD}"]
      interval: 5s
      retries: 10
      timeout: 5s
      start_period: 10s
    networks:
      - decalog_planno

volumes:
  db_data:

networks:
  decalog_planno:
    name: ${ENV_NAME}_decalog_planno

